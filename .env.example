NEXT_PUBLIC_PROJECT_ID=
# Optional WalletConnect metadata URL. The actual browser origin must still be
# allowed in the Reown/WalletConnect dashboard for this project id.
NEXT_PUBLIC_APP_URL=
# Orbs-only wallet picker. Set false to use the standard RainbowKit picker.
NEXT_PUBLIC_ORBS_CONNECT_MODAL=true
RPC_URL=

# Supported values:
# - default
# - efficient-frontier
# - ht-digital
NEXT_PARTNER=orbs
