# Optional Reown project ID; enables WalletConnect and mobile wallet pairing.
NEXT_PUBLIC_PROJECT_ID=
# Optional WalletConnect metadata URL. The actual browser origin must still be
# allowed in the Reown/WalletConnect dashboard for this project id.
NEXT_PUBLIC_APP_URL=
# Optional custom Orbs picker override; also requires features.customConnectModal.
NEXT_PUBLIC_ORBS_CONNECT_MODAL=false
# Optional chain-aware gateway; receives chainId and appId query parameters.
RPC_URL=
# Or map chain IDs to private HTTP(S) RPC URLs. When RPC_URL is unset, only these networks are offered.
# Optional per-instance request ceiling; use host-level rate limiting as well.
RPC_RATE_LIMIT_PER_MINUTE=600
# RPC_URLS='{"1":"https://your-ethereum-rpc.example","56":"https://your-bsc-rpc.example"}'

# White-label identity. Leave unset to retain the Orbs reference appearance.
# Use your own stable ID to avoid Orbs-specific styling and identify RPC requests.
APP_ID=
APP_NAME=
APP_WORDMARK=
APP_TRADING_LABEL=
APP_LOGO_URL=
APP_LOGO_ALT=
APP_ICON_URL=
APP_APPLE_ICON_URL=
APP_TITLE=
APP_DESCRIPTION=
APP_DEFAULT_THEME=light
# Optional single six-digit hex brand color; quote # values. Generates both palettes.
APP_PRIMARY_COLOR=

# JSON objects of PartnerStyles overrides, applied separately for each mode.
# Quote values containing #; use public asset paths or HTTPS URLs for branding.
APP_THEME_LIGHT=
APP_THEME_DARK=

# Public Spot partner identifier configured for your enabled chains.
NEXT_PARTNER=external
NEXT_PUBLIC_SPOT_DOCS_URL=
